# Copy to .env and fill in. Never commit .env.

# ─── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Signs login sessions. Generate with: openssl rand -hex 32
AUTH_SECRET=""

# ─── AI chat analysis (one of these) ───────────────────────────────────────────
GROQ_API_KEY=""
# GROQ_MODEL="llama-3.3-70b-versatile"
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
# CHAT_ANALYSIS_PROVIDER="groq"   # groq | openrouter

# ─── Instagram / Facebook app (developers.facebook.com) ───────────────────────
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/instagram/auth"
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=""
# Public URL of this app (use an ngrok URL while testing webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── WhatsApp worker (optional) ────────────────────────────────────────────────
# WHATSAPP_AUTH_DIR=".data/baileys-auth"
# WHATSAPP_LOG_LEVEL="info"
# WHATSAPP_HISTORY_CHAT_LIMIT=100
# WHATSAPP_HISTORY_CONTACT_LIMIT=100
# WHATSAPP_HISTORY_MESSAGE_LIMIT=1000
# WHATSAPP_HISTORY_BACKFILL_ENABLED=true
# WHATSAPP_HISTORY_BACKFILL_CHAT_LIMIT=5
# WHATSAPP_HISTORY_BACKFILL_MESSAGE_LIMIT=50
